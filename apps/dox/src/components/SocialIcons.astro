---
// Override of Starlight's SocialIcons so each link is a reusable ButtonLink —
// which routes the absolute `href` through the external-link handling
// (target="_blank" rel="noopener noreferrer"). Starlight's default renders a
// bare same-tab <a>.
import config from 'virtual:starlight/user-config';
import ButtonLink from './ButtonLink.astro';

const links = config.social ?? [];
---

{
	links.map(({ label, href, icon }) => (
		<ButtonLink href={href} label={label} icon={icon} rel="me" class="social-icon" />
	))
}

<style>
	/* Match Starlight's original hit-area padding. */
	.social-icon {
		padding: 0.5em;
		margin: -0.5em;
	}
</style>
