---
// Override of Starlight's ThemeSelect for 2-state theme toggle.
---

<starlight-theme-select>
  <button
    type="button"
    class="theme-toggle"
    aria-label="Toggle color theme"
  >
    <svg
      class="theme-icon"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    ></svg>
  </button>
</starlight-theme-select>

{/* Inlined to avoid FOUC. Uses global scope from `ThemeProvider.astro`. */}
<script is:inline>
  StarlightThemeProvider.updatePickers();
</script>

<script>
  declare const StarlightThemeProvider: {
    updatePickers(): void;
  };

  const storageKey = 'starlight-theme';

  function loadTheme(): string {
    const stored =
      typeof localStorage !== 'undefined' && localStorage.getItem(storageKey);
    return stored === 'light' || stored === 'dark' ? stored : '';
  }

  function getSystemPref(): string {
    return window.matchMedia('(prefers-color-scheme: light)').matches
      ? 'light'
      : 'dark';
  }

  function applyTheme(theme: string) {
    document.documentElement.dataset.theme = theme || getSystemPref();
    StarlightThemeProvider.updatePickers();
  }

  class StarlightThemeSelect extends HTMLElement {
    constructor() {
      super();
      const btn = this.querySelector('button.theme-toggle');
      if (btn) {
        btn.addEventListener('click', () => {
          const stored = loadTheme();
          const systemPref = getSystemPref();
          if (stored === 'light' || stored === 'dark') {
            localStorage.removeItem(storageKey);
            applyTheme(systemPref);
          } else {
            const opposite = systemPref === 'light' ? 'dark' : 'light';
            localStorage.setItem(storageKey, opposite);
            applyTheme(opposite);
          }
        });
      }

      matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
        const stored = loadTheme();
        if (!stored) {
          applyTheme(getSystemPref());
        }
      });

      applyTheme(loadTheme());
    }
  }

  customElements.define('starlight-theme-select', StarlightThemeSelect);
</script>

<style>
  /*
   * Same treatment as the GitHub / social icon buttons (see the "Unified icon
   * buttons" rule in gmt-site.css): transparent at rest, glass chip on hover.
   */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--gmt-radius-sm);
    color: var(--gmt-cyan-bright);
    cursor: pointer;
    transition:
      color var(--gmt-duration-fast) var(--gmt-easing),
      border-color var(--gmt-duration-fast) var(--gmt-easing),
      background var(--gmt-duration-fast) var(--gmt-easing);
    corner-shape: bevel;
  }

  .theme-toggle:hover {
    color: var(--gmt-cyan);
    background: color(from var(--gmt-teal) srgb r g b / 0.12);
    border-color: color(from var(--gmt-cyan) srgb r g b / 0.18);
    box-shadow: 0 0 8px color(from var(--gmt-cyan) srgb r g b / 0.15);
    backdrop-filter: blur(var(--gmt-blur)) saturate(var(--gmt-saturate));
  }

  .theme-icon {
    width: 1em;
    height: 1em;
  }
</style>
